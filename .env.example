# Copy to .env and adjust. Every setting is documented in app/config.py.
DATABASE_URL=sqlite:///./dq_monitor.db
LOG_LEVEL=INFO

# JWT signing key. Required (32+ chars) whenever ENVIRONMENT is not "local".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
ACCESS_TOKEN_MINUTES=60

# Optional: create this editor on startup if there are no users yet.
# BOOTSTRAP_EDITOR_EMAIL=admin@example.com
# BOOTSTRAP_EDITOR_PASSWORD=admin-password

# Leave eager mode on to run checks inline without RabbitMQ (local dev).
# Set to false and point at RabbitMQ to use real background workers.
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
RUN_TASK_MAX_RETRIES=3
SCHEDULER_TICK_SECONDS=60

# Redis read cache + rate limiting. Leave unset to disable both.
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Optional: Slack incoming webhook (or any URL accepting JSON POSTs).
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
